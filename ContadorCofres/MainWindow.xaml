<Window x:Class="ContadorCofres.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ContadorCofres"
        mc:Ignorable="d"
        Title="Contador de Cofres 01" Height="200" Width="170"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        WindowStyle="None">
    <Grid Background="#20242A">
    <StackPanel Margin="20">
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Contador de cofres"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Cursor="SizeAll"
                       MouseLeftButtonDown="OverlayTitle_MouseLeftButtonDown"/>

            <Button Grid.Column="1"
                    Content="X"
                    Width="28"
                    Height="28"
                    Background="Transparent"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="Bold"
                    ToolTip="Cerrar"
                    Click="CloseOverlay_Click"/>
        </Grid>

        <TextBlock x:Name="ChestCountText"
                   Text="0"
                   Foreground="White"
                   FontSize="48"
                   HorizontalAlignment="Center"
                   Margin="0,12"/>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <!-- ///<Button x:Name="IncrementButton"
                    Click="IncrementButton_Click"
                    Content="+1"
                    Padding="16,8"
                    Margin="4"/>
            <Button x:Name="DecrementButton"
                    Click="DecrementButton_Click"
                    Content="-1"
                    Padding="16,8"
                    Margin="4"/>
            <Button x:Name="ResetButton"
                    Click="ResetButton_Click"
                    Content="Reiniciar"
                    Padding="12,8"
                    Margin="4"/>/// -->
            <Button Content="Configuración"
                    Click="OpenSettings_Click"
                    Padding="12,8"
                    Margin="4"/>
        </StackPanel>
    </StackPanel>
</Grid>
</Window>
