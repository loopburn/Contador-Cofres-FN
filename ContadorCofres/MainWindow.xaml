<Window x:Class="ContadorCofres.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ContadorCofres"
        mc:Ignorable="d"
        Title="Contador de Cofres 01" Height="125" Width="170"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        WindowStyle="None">
    <Grid Background="#20242A">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="8,6,6,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="COFRES"
                       Foreground="White"
                       FontSize="12"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Cursor="SizeAll"
                       MouseLeftButtonDown="OverlayTitle_MouseLeftButtonDown"/>

            <Button Grid.Column="1"
                    Content="⚙"
                    Width="26"
                    Height="26"
                    Background="Transparent"
                    Foreground="White"
                    BorderThickness="0"
                    ToolTip="Configuración"
                    Click="OpenSettings_Click"/>

            <Button Grid.Column="2"
                    Content="X"
                    Width="26"
                    Height="26"
                    Background="Transparent"
                    Foreground="White"
                    BorderThickness="0"
                    ToolTip="Cerrar"
                    Click="CloseOverlay_Click"/>
        </Grid>

        <TextBlock Grid.Row="1"
                   x:Name="ChestCountText"
                   Text="0"
                   Foreground="White"
                   FontSize="42"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
    </Grid>
</Window>
